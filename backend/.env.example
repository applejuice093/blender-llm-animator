# Copy to backend/.env (git-ignored) and export before starting the API, e.g.
#   set -a && source backend/.env && set +a
# All values are optional; the defaults are shown.

# Blender (optional: only needed for headless validation / dataset generation)
# BLENDER_EXECUTABLE=/usr/bin/blender
# BLEND_FILE=/path/to/character.blend
# BLENDER_VALIDATION_TIMEOUT=30
# BLENDER_HOST=127.0.0.1
# BLENDER_PORT=8123

# Rhubarb lip sync (optional)
# RHUBARB_EXECUTABLE=/usr/local/bin/rhubarb
# TOOLS_DIR=tools

# Ollama planner
# OLLAMA_URL=http://127.0.0.1:11434/api/generate
# OLLAMA_MODEL=qwen3:4b
# OLLAMA_TIMEOUT=120

# Storage (relative paths are resolved against backend/)
# CHROMA_DB_DIR=chroma_db
# CHROMA_COLLECTION=knowledge_store
# DATASET_DIR=datasets
# LORA_OUTPUT_DIR=lora_output

# API
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# LOG_LEVEL=INFO
